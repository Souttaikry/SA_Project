# Copy this file to .env and fill in your real values

# MongoDB connection string (MongoDB Atlas or local)
# Local example:   mongodb://127.0.0.1:27017/stockdb
# Atlas example:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/stockdb
MONGO_URI=mongodb://127.0.0.1:27017/stockdb

# Secret used to sign login tokens - change this to a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the server runs on
PORT=5000

# Default admin account created by "npm run seed"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
